<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SentryDisableSourceGenerator>true</SentryDisableSourceGenerator>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnhancedAuthReferencePath Condition="'$(EnhancedAuthReferencePath)' == ''">../LazerAuthlibInjection/osu.Game.Rulesets.EnhancedAuth/bin/SomsAiExitFix/merged/osu.Game.Rulesets.EnhancedAuth.dll</EnhancedAuthReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../TestSupport/QuietTestProcess.cs" Link="QuietTestProcess.cs" />
    <PackageReference Include="ppy.osu.Game" Version="2026.730.0" />
    <Reference Include="osu.Game.Rulesets.EnhancedAuth">
      <HintPath>$(EnhancedAuthReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
