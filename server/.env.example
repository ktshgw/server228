# View https://docs.g0v0.top/lazer/reference/configurations.html for details.
HOST="0.0.0.0"
PORT=8000
DEBUG=false
DEFAULT_COUNTRY_CODE=XX

MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_DATABASE="osu_api"
MYSQL_USER="osu_api"
MYSQL_PASSWORD="replace_with_a_random_database_password"
MYSQL_ROOT_PASSWORD="replace_with_a_different_random_root_password"
REDIS_URL="redis://127.0.0.1:6379"

JWT_SECRET_KEY="replace_with_64_random_hex_characters"
JWT_AUDIENCE="5"
# Public DNS hostname without https:// or a path. Used by
# docker-compose.easy.yml to obtain a trusted TLS certificate automatically.
SERVER_DOMAIN="private-osu.example"
SERVER_URL="https://private-osu.example/"

# Native lazer OAuth credentials. ClientId/secret must match launcher.json.
# A native-client secret is not confidential; never reuse an admin or upstream secret.
OSU_CLIENT_ID=5
OSU_CLIENT_SECRET="replace_with_a_random_native_client_secret"
OSU_WEB_CLIENT_ID=6
OSU_WEB_CLIENT_SECRET="replace_with_a_different_random_secret"

FETCHER_CLIENT_ID=""
FETCHER_CLIENT_SECRET=""

ENABLE_EMAIL_VERIFICATION=false
ENABLE_TOTP_VERIFICATION=true
ENABLE_SESSION_VERIFICATION=false
ENABLE_MULTI_DEVICE_LOGIN=true
MAX_TOKENS_PER_CLIENT=10
DEVICE_TRUST_DURATION_DAYS=30

ENABLE_RX=true
ENABLE_AP=true
ENABLE_SUPPORTER_FOR_ALL_USERS=true
ENABLE_ALL_BEATMAP_LEADERBOARD=false
ENABLE_ALL_BEATMAP_PP=false
PRIVATE_USER_ID_BASE=1500000000
ENABLE_AUTO_BEATMAP_SYNC=true
# Discover the complete Ranked/Approved Featured Artist catalogue every day.
ENABLE_RANKED_CATALOGUE_SYNC=true
SCORING_MODE=standardised
ENABLE_RATE_LIMIT=true
SEASONAL_BACKGROUNDS=[]

CORS_URLS='[]'
# FRONTEND_URL="https://private-osu.example/"

# Required by spectator's interop client. The current FastAPI endpoint does not
# authenticate this value, so Docker isolation and the public /_lio deny remain
# the actual security boundary. Generate it independently from all other keys.
SHARED_INTEROP_SECRET="replace_with_a_random_interop_secret"

# Spectator must capture completed plays before it can upload their .osr data
# to the API. The API then retains only the best solo leaderboard replay for
# each player/difficulty/ruleset/exact mod configuration.
SAVE_REPLAYS=true
REPLAY_UPLOAD_THREADS=1
# Seconds before Ranked may match the same pair again (0 disables the cooldown).
MATCHMAKING_RECENT_MATCHUP_TIMEOUT=30
