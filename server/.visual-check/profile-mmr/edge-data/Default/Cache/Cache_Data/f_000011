        if (state.rankedBusy) return;
        state.rankedBusy = true;
        $$("input, select, textarea, button", $("#view-ranked")).forEach((control) => { control.disabled = true; });
        try {
            await action();
        } catch (error) {
            toast(error.message, "error");
        } finally {
            state.rankedBusy = false;
            $$("input, select, textarea, button", $("#view-ranked")).forEach((control) => { control.disabled = false; });
            $("#ranked-pool-apply").disabled = !state.ranked?.pools.length;
        }
    }

