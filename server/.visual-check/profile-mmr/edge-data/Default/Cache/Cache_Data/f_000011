    function updateRankedPresetSource() {
        $("#ranked-preset-ids-field").hidden = $("#ranked-preset-source").value !== "manual";
    }

    function rankedPresetSpec() {
        const [ruleset_id, variant_id] = $("#ranked-preset-mode").value.split(":").map(Number);
        const name = $("#ranked-preset-name").value.trim();
        const min_stars = Number($("#ranked-preset-min-stars").value);
        const max_stars = Number($("#ranked-preset-max-stars").value);
        const min_length = Number($("#ranked-preset-min-length").value);
        const max_length = Number($("#ranked-preset-max-length").value);
        if (name.length < 2 || min_stars > max_stars || min_length > max_length) throw new Error("Укажите название и проверьте диапазоны фильтров");
        let beatmap_ids = null;
        if ($("#ranked-preset-source").value === "manual") {
            beatmap_ids = [...new Set($("#ranked-preset-ids").value.trim().split(/[\s,;]+/).map((entry) => {
                const match = entry.match(/^(?:https?:\/\/osu\.ppy\.sh\/beatmaps\/(\d+)(?:\?[^\s]*)?|(\d+))$/);
                const id = match ? Number(match[1] || match[2]) : 0;
                if (!Number.isSafeInteger(id) || id <= 0) throw new Error(`Не удалось прочитать ID сложности: ${entry || "пустой список"}`);
                return id;
            }))];
            if (beatmap_ids.length > 1000) throw new Error("В пресете допускается до 1000 сложностей");
        }
        return { name, ruleset_id, variant_id, min_stars, max_stars, min_length, max_length, beatmap_ids };
    }

