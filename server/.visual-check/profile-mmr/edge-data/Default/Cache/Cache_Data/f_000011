        await runRankedAction(async () => {
            const data = await api("/ranked/preview", { method: "POST", data: rankedPresetSpec() });
            const root = $("#ranked-preset-preview-result");
            root.replaceChildren(make("strong", "", `Подходит карт: ${formatNumber(data.count)}${data.count < data.minimum ? " · для игры нужно минимум 10" : ""}`));
