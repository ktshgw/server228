<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#111522">
    <title>Панель управления — private osu!</title>
    <link rel="icon" href="./favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="./styles.css">
</head>
<body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>

    <main id="login-screen" class="login-screen">
        <section class="login-card" aria-labelledby="login-title">
            <div class="brand brand-login">
                <span class="brand-mark" aria-hidden="true">o!</span>
                <span><strong>private</strong><small>control room</small></span>
            </div>
            <div class="login-copy">
                <p class="eyebrow">Закрытая зона</p>
                <h1 id="login-title">Добро пожаловать</h1>
                <p>Войдите под аккаунтом сотрудника сервера. Пароль отправляется только вашему серверу и нигде не сохраняется.</p>
            </div>
            <form id="login-form" class="stack" autocomplete="on">
                <label class="field">
                    <span>Имя пользователя</span>
                    <input id="login-username" name="username" type="text" autocomplete="username" required minlength="2" maxlength="254" autofocus>
                </label>
                <label class="field">
                    <span>Пароль</span>
                    <input id="login-password" name="password" type="password" autocomplete="current-password" required maxlength="512">
                </label>
                <label id="totp-field" class="field" hidden>
                    <span>Код двухфакторной защиты</span>
                    <input id="login-totp" name="totp_code" type="text" inputmode="numeric" autocomplete="one-time-code" minlength="6" maxlength="32" placeholder="6 цифр или резервный код">
                </label>
                <p id="login-error" class="form-message error-message" role="alert" hidden></p>
                <button id="login-submit" class="button button-primary button-large" type="submit">
                    <span>Войти в панель</span>
                    <span class="button-arrow" aria-hidden="true">→</span>
                </button>
            </form>
            <p class="secure-note"><span aria-hidden="true">●</span> Защищённая сессия на 8 часов</p>
            <a class="site-return-link" href="/site/">← На сайт SOMS!</a>
        </section>
    </main>

    <div id="admin-app" class="app-shell" hidden>
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-mark" aria-hidden="true">o!</span>
                <span><strong>private</strong><small>control room</small></span>
            </div>

            <nav class="nav" aria-label="Основная навигация">
                <button class="nav-item is-active" type="button" data-view="dashboard" data-capability="staff">
                    <span class="nav-icon" aria-hidden="true">⌂</span><span>Обзор</span>
                </button>
                <button class="nav-item" type="button" data-view="users" data-capability="administrator">
                    <span class="nav-icon" aria-hidden="true">◉</span><span>Пользователи</span>
                </button>
                <button class="nav-item" type="button" data-view="imports" data-capability="owner">
                    <span class="nav-icon" aria-hidden="true">⇧</span><span>Импорт score</span>
                </button>
                <button class="nav-item" type="button" data-view="beatmaps" data-capability="ranker">
                    <span class="nav-icon" aria-hidden="true">◇</span><span>Карты</span>
                </button>
                <button class="nav-item" type="button" data-view="inbox" data-capability="ranker">
                    <span class="nav-icon" aria-hidden="true">◌</span><span>Уведомления</span>
                    <span id="nav-inbox-badge" class="nav-badge" hidden>0</span>
                </button>
                <button class="nav-item" type="button" data-view="ranked" data-capability="administrator">
                    <span class="nav-icon" aria-hidden="true">⚔</span><span>Ranked</span>
                </button>
                <button class="nav-item" type="button" data-view="audit" data-capability="administrator">
                    <span class="nav-icon" aria-hidden="true">≡</span><span>История</span>
                </button>
                <button class="nav-item" type="button" data-view="system" data-capability="staff">
                    <span class="nav-icon" aria-hidden="true">⚙</span><span>Система</span>
                </button>
            </nav>

            <div class="sidebar-footer">
                <a class="site-return-link" href="/site/">← На сайт SOMS!</a>
                <div id="sidebar-server-status" class="server-pill"><span class="status-dot"></span><span>Проверяем сервер…</span></div>
                <button id="logout-button" class="logout-button" type="button">Выйти</button>
            </div>
        </aside>

        <main class="workspace">
            <header class="topbar">
                <div>
                    <p id="page-kicker" class="eyebrow">Главная</p>
                    <h1 id="page-title">Обзор сервера</h1>
                </div>
                <div class="topbar-actions">
                    <button id="refresh-button" class="icon-button" type="button" aria-label="Обновить данные" title="Обновить">↻</button>
                    <button id="profile-button" class="profile-chip" type="button" title="Текущий аккаунт">
                        <span id="profile-avatar" class="avatar avatar-small"></span>
                        <span class="profile-text"><strong id="profile-name">—</strong><small id="profile-role">—</small></span>
                    </button>
                </div>
            </header>

            <div id="page-loading" class="page-loading" aria-live="polite" hidden><span></span><span>Загрузка…</span></div>

            <section id="view-dashboard" class="page is-active" data-page="dashboard" aria-labelledby="dashboard-heading">
                <div class="welcome-panel">
                    <div>
                        <p class="eyebrow">Всё под контролем</p>
                        <h2 id="dashboard-heading">Привет, <span id="welcome-name">администратор</span></h2>
                        <p>Здесь видно состояние сервера, активность игроков и события, требующие внимания.</p>
                    </div>
                    <div class="welcome-orbit" aria-hidden="true"><span>o!</span></div>
                </div>

                <div id="dashboard-metrics" class="metrics-grid" aria-live="polite"></div>

                <div class="dashboard-grid">
                    <article class="panel">
                        <div class="panel-header">
                            <div><p class="eyebrow">Сервисы</p><h3>Состояние системы</h3></div>
                            <button class="text-button" type="button" data-go="system">Подробнее</button>
                        </div>
                        <div id="dashboard-health" class="health-list"></div>
                    </article>
                    <article class="panel">
                        <div class="panel-header">
                            <div><p class="eyebrow">Карты</p><h3>Требуют внимания</h3></div>
                            <button class="text-button" type="button" data-go="inbox" data-capability="ranker">Открыть все</button>
                        </div>
                        <div id="dashboard-inbox" class="empty-state compact"><span class="empty-icon">✓</span><strong>Пока всё спокойно</strong><p>Новых событий нет.</p></div>
                    </article>
                </div>
            </section>

            <section id="view-users" class="page" data-page="users" aria-labelledby="users-heading" hidden>
                <div class="section-heading">
                    <div><p class="eyebrow">Аккаунты</p><h2 id="users-heading">Пользователи</h2><p>Поиск, роли, страна и состояние аккаунта.</p></div>
                </div>
                <article class="panel table-panel">
                    <div class="toolbar">
                        <label class="search-field">
                            <span aria-hidden="true">⌕</span>
                            <input id="user-search" type="search" placeholder="Имя или ID пользователя" maxlength="64" autocomplete="off">
                        </label>
                        <span id="user-count" class="muted">— пользователей</span>
                    </div>
                    <div class="table-scroll">
                        <table>
                            <thead><tr><th>Пользователь</th><th>Страна</th><th>Роли</th><th>Статус</th><th>Последний визит</th><th><span class="sr-only">Действия</span></th></tr></thead>
                            <tbody id="users-table-body"></tbody>
                        </table>
                    </div>
                    <div id="users-empty" class="empty-state" hidden><span class="empty-icon">⌕</span><strong>Никого не нашли</strong><p>Попробуйте изменить запрос.</p></div>
                    <div class="pagination">
                        <button id="users-prev" class="button button-secondary" type="button">← Назад</button>
                        <span id="users-page">Страница 1 из 1</span>
                        <button id="users-next" class="button button-secondary" type="button">Вперёд →</button>
                    </div>
                </article>
            </section>

            <section id="view-imports" class="page" data-page="imports" aria-labelledby="imports-heading" hidden>
                <div class="section-heading">
                    <div><p class="eyebrow">Перенос результатов</p><h2 id="imports-heading">Импорт score</h2><p>Перенесите публичный результат с официального osu! на выбранный локальный аккаунт.</p></div>
                </div>
                <div class="two-column">
                    <article class="panel sticky-panel">
                        <div class="panel-header"><div><p class="eyebrow">Только для владельца</p><h3>Новый импорт</h3></div></div>
                        <form id="score-import-form" class="stack">
                            <label class="field"><span>Ссылка на score или его ID</span><input id="score-import-source" type="text" maxlength="300" placeholder="https://osu.ppy.sh/scores/…" autocomplete="off"></label>
                            <div class="import-source-divider"><span>или</span></div>
                            <label class="field"><span>Файл replay (.osr)</span><input id="score-import-file" type="file" accept=".osr,application/x-osu-replay,application/octet-stream"><small id="score-import-file-help">Карта и режим определятся автоматически.</small></label>
                            <div class="form-grid">
                                <label class="field"><span>Короткий ID игрока</span><input id="score-import-user-id" type="number" min="1" required placeholder="например, 1"></label>
                                <label class="field"><span>Режим старого score</span><select id="score-import-ruleset"><option value="">Определить автоматически</option><option value="osu">osu!</option><option value="taiko">taiko</option><option value="fruits">catch</option><option value="mania">mania</option></select></label>
                            </div>
                            <label class="field"><span>ID сложности карты для старого .osr (необязательно)</span><input id="score-import-beatmap-id" type="number" min="1" placeholder="Нужен только если карта не определилась автоматически"><small>Обычно оставьте пустым.</small></label>
                            <label class="switch-line import-replay-option"><input id="score-import-replay" type="checkbox" checked><span>Попытаться перенести официальный replay</span></label>
                            <label class="switch-line unsafe-import-option">
                                <input id="score-import-unsafe-revision" type="checkbox">
                                <span><strong>Принудительно дать рейтинг и PP без подтверждения ревизии</strong><small>Рискованный режим владельца: старая версия карты может посчитать PP неправильно. Оставьте выключенным, если не уверены.</small></span>
                            </label>
                            <label class="field"><span>Причина переноса</span><textarea id="score-import-reason" required minlength="2" maxlength="500" rows="3" placeholder="Например: перенос моих старых результатов"></textarea></label>
                            <div id="score-import-preview" class="ranking-preview score-import-preview" hidden></div>
                            <div class="button-row">
                                <button id="score-import-preview-button" class="button button-secondary" type="button">Сначала проверить</button>
                                <button id="score-import-submit" class="button button-primary" type="submit" disabled>Импортировать</button>
                            </div>
                            <p class="warning-note"><strong>Важно:</strong> сервер получает score напрямую из публичного API osu! и сверяет карту по replay. Подтверждённый результат получает обычный локальный расчёт PP. Неподтверждённый по умолчанию остаётся видимым в профиле, но не попадает в рейтинг и не даёт PP. Всё записывается в историю.</p>
                        </form>
                    </article>
                    <article class="panel">
                        <div class="panel-header">
                            <div><p class="eyebrow">Журнал происхождения</p><h3>Последние импорты</h3></div>
                            <span id="score-import-count" class="counter">0</span>
                        </div>
                        <div id="score-import-list" class="import-list"></div>
                        <div id="score-import-empty" class="empty-state"><span class="empty-icon">⇧</span><strong>Импортов пока нет</strong><p>После первого переноса он появится здесь.</p></div>
                    </article>
                </div>
            </section>

            <section id="view-beatmaps" class="page" data-page="beatmaps" aria-labelledby="beatmaps-heading" hidden>
                <div class="section-heading">
                    <div><p class="eyebrow">Локальный рейтинг</p><h2 id="beatmaps-heading">Карты</h2><p>Дайте ранг всему сету или отдельной сложности независимо от Bancho.</p></div>
                </div>
                <div class="two-column">
                    <article class="panel sticky-panel">
                        <div class="panel-header"><div><p class="eyebrow">Изменение</p><h3>Ранг карты</h3></div></div>
                        <form id="ranking-form" class="stack">
                            <fieldset class="segmented-field">
                                <legend>Действие</legend>
                                <div class="segmented segmented-three">
                                    <label><input type="radio" name="action" value="rank" checked><span>Выдать ранг</span></label>
                                    <label><input type="radio" name="action" value="unrank"><span>Принудительно unrank</span></label>
                                    <label><input type="radio" name="action" value="inherit"><span>Наследовать Bancho</span></label>
                                </div>
                            </fieldset>
                            <label class="field"><span>ID сета карты</span><span class="field-action"><input id="ranking-set-id" name="beatmapset_id" type="number" min="1" required placeholder="например, 1234567"><button id="ranking-inspect" class="button button-secondary" type="button">Проверить</button></span></label>
                            <div id="ranking-preview" class="ranking-preview" hidden></div>
                            <fieldset class="segmented-field">
                                <legend>Область</legend>
                                <div class="segmented">
                                    <label><input type="radio" name="scope" value="set" checked><span>Весь сет</span></label>
                                    <label><input type="radio" name="scope" value="difficulty"><span>Одна сложность</span></label>
                                </div>
                            </fieldset>
                            <label id="ranking-map-field" class="field" hidden><span>ID сложности</span><input id="ranking-map-id" name="beatmap_id" type="number" min="1" placeholder="например, 7654321"></label>
                            <div id="ranking-options" class="stack">
                                <label class="field"><span>Статус</span><select id="ranking-status" name="status"><option value="1">Ranked</option><option value="4">Loved</option></select></label>
                                <div id="ranking-outcome" class="ranking-outcome" aria-live="polite"></div>
                            </div>
                            <label class="field"><span>Причина</span><textarea id="ranking-reason" name="reason" required minlength="2" maxlength="500" rows="3" placeholder="Почему меняется статус карты"></textarea></label>
                            <button id="ranking-submit" class="button button-primary" type="submit">Применить</button>
                            <p class="form-hint">Перед выдачей ранга сервер проверит свежие данные карты на osu!. Ranked всегда включает лидерборд и PP; Loved — лидерборд без PP.</p>
                            <p class="warning-note"><strong>Важно:</strong> «Принудительно unrank» снимает активный локальный ранг с возвратом к статусу Bancho; карту с лидербордом Bancho переносит в Graveyard на этом сервере. «Наследовать Bancho» удаляет локальное правило. Изменение допуска очищает связанные строки локального лидерборда и PP; правило на весь сет не удаляет отдельные правила сложностей.</p>
                        </form>
                    </article>
                    <article class="panel">
                        <div class="panel-header">
                            <div><p class="eyebrow">Активные правила</p><h3>Локально изменённые карты</h3></div>
                            <span id="policies-count" class="counter">0</span>
                        </div>
                        <div id="policies-list" class="policy-list"></div>
                        <div id="policies-empty" class="empty-state"><span class="empty-icon">◇</span><strong>Локальных правил пока нет</strong><p>Выдайте ранг карте — она появится здесь.</p></div>
                    </article>
                </div>
            </section>

            <section id="view-inbox" class="page" data-page="inbox" aria-labelledby="inbox-heading" hidden>
                <div class="section-heading split-heading">
                    <div><p class="eyebrow">Мониторинг карт</p><h2 id="inbox-heading">Уведомления</h2><p>Изменения на Bancho, которые могли затронуть локальный ранг.</p></div>
                    <label class="switch-line"><input id="include-resolved" type="checkbox"><span>Показать закрытые</span></label>
                </div>
                <div id="events-list" class="event-list"></div>
                <div id="events-empty" class="empty-state panel"><span class="empty-icon">✓</span><strong>Новых уведомлений нет</strong><p>Сервер сообщит здесь, если официальная версия карты изменится.</p></div>
            </section>

            <section id="view-audit" class="page" data-page="audit" aria-labelledby="audit-heading" hidden>
                <div class="section-heading">
                    <div><p class="eyebrow">Безопасность</p><h2 id="audit-heading">История действий</h2><p>Кто, когда и что менял в аккаунтах и картах.</p></div>
                </div>
                <div class="tabs" role="tablist" aria-label="Тип истории">
                    <button class="tab is-active" id="audit-account-tab" type="button" role="tab" aria-selected="true" data-audit-tab="account">Аккаунты</button>
                    <button class="tab" id="audit-ranking-tab" type="button" role="tab" aria-selected="false" data-audit-tab="ranking">Карты</button>
                </div>
                <article class="panel table-panel">
                    <div class="table-scroll">
                        <table>
                            <thead id="audit-table-head"></thead>
                            <tbody id="audit-table-body"></tbody>
                        </table>
                    </div>
                    <div id="audit-empty" class="empty-state" hidden><span class="empty-icon">≡</span><strong>История пока пуста</strong><p>Изменения появятся после первого действия.</p></div>
                </article>
            </section>

            <section id="view-ranked" class="page" data-page="ranked" aria-labelledby="ranked-heading" hidden>
                <div class="section-heading"><div><p class="eyebrow">Рейтинговый мультиплеер</p><h2 id="ranked-heading">Пресеты и пулы</h2><p>Пресет задаёт доступный набор карт. Внутри него карты подбираются под Elo игроков. Для игры нужно минимум 10 подходящих сложностей.</p></div></div>
                <div class="two-column">
                    <article class="panel">
                        <div class="panel-header"><h3>Активный набор</h3></div>
                        <form id="ranked-pool-form" class="stack">
                            <label class="field"><span>Режим и пул</span><select id="ranked-pool-select" required></select></label>
                            <p id="ranked-pool-count" class="muted" aria-live="polite"></p>
                            <label class="field"><span>Пресет</span><select id="ranked-pool-preset"></select></label>
                            <label class="field"><span>Причина изменения</span><input id="ranked-pool-reason" minlength="2" maxlength="500" required></label>
                            <button id="ranked-pool-apply" class="button button-primary" type="submit">Применить к новым матчам</button>
                        </form>
                        <p class="muted">По умолчанию — общий каталог Featured Artists из osu!: Ranked/Approved, 60–300 секунд, исходный режим карты. Каталог пополняется автоматически независимо от игр пользователей. Свой пресет заменяет эти ограничения.</p>
                        <p id="ranked-catalogue-status" class="muted" aria-live="polite"></p>
                    </article>
                    <article class="panel">
                        <div class="panel-header"><h3>Пресеты</h3><button id="ranked-preset-new" class="button button-secondary" type="button">Создать</button></div>
                        <label class="field"><span>Открыть пресет</span><select id="ranked-preset-select"></select></label>
                        <form id="ranked-preset-form" class="stack">
                            <label class="field"><span>Название</span><input id="ranked-preset-name" required minlength="2" maxlength="80" placeholder="Например: Разминка 3–5★"></label>
                            <label class="field"><span>Режим</span><select id="ranked-preset-mode"><option value="0:0">osu!</option><option value="1:0">osu!taiko</option><option value="2:0">osu!catch</option><option value="3:4">osu!mania 4K</option><option value="3:7">osu!mania 7K</option></select></label>
                            <div class="form-grid">
                                <label class="field"><span>Звёзды от</span><input id="ranked-preset-min-stars" type="number" min="0" max="20" step="0.1" value="0" required></label>
                                <label class="field"><span>Звёзды до</span><input id="ranked-preset-max-stars" type="number" min="0" max="20" step="0.1" value="15" required></label>
                                <label class="field"><span>Длительность от, сек.</span><input id="ranked-preset-min-length" type="number" min="0" max="1800" value="60" required></label>
                                <label class="field"><span>Длительность до, сек.</span><input id="ranked-preset-max-length" type="number" min="1" max="1800" value="240" required></label>
                            </div>
                            <label class="field"><span>Источник карт</span><select id="ranked-preset-source"><option value="auto">Локальный каталог по фильтрам</option><option value="manual">Мой список сложностей</option></select></label>
                            <label id="ranked-preset-ids-field" class="field" hidden><span>ID сложностей или ссылки /beatmaps/…</span><textarea id="ranked-preset-ids" rows="4" placeholder="725718, 2599592"></textarea><small>Карты должны быть в локальном каталоге и проходить фильтры выше. Предпросмотр покажет исключённые ID.</small></label>
                            <label class="field"><span>Причина изменения</span><input id="ranked-preset-reason" minlength="2" maxlength="500" required></label>
                            <div class="button-row"><button id="ranked-preset-preview" class="button button-secondary" type="button">Проверить карты</button><button id="ranked-preset-save" class="button button-primary" type="submit">Сохранить пресет</button></div>
                            <p class="muted">Сохранённый пресет выбирается слева. Правки уже активного пресета также применяются к новым матчам.</p>
                        </form>
                        <div id="ranked-preset-preview-result" class="stack" aria-live="polite"></div>
                    </article>
                </div>
            </section>
            <section id="view-system" class="page" data-page="system" aria-labelledby="system-heading" hidden>
                <div class="section-heading">
                    <div><p class="eyebrow">Диагностика</p><h2 id="system-heading">Система</h2><p>Текущее состояние и безопасные параметры сервера.</p></div>
                </div>
                <div id="system-health" class="service-grid"></div>
                <article class="panel">
                    <div class="panel-header"><div><p class="eyebrow">Конфигурация</p><h3>Параметры сервера</h3></div><span class="read-only-pill">Только чтение</span></div>
                    <dl id="system-settings" class="settings-list"></dl>
                </article>
            </section>
        </main>
    </div>

    <dialog id="user-dialog" class="dialog dialog-wide">
        <form method="dialog"><button class="dialog-close" value="cancel" aria-label="Закрыть">×</button></form>
        <div id="user-dialog-loading" class="dialog-loading">Загружаем пользователя…</div>
        <div id="user-dialog-content" hidden>
            <div class="user-hero">
                <span id="detail-avatar" class="avatar avatar-large"></span>
                <div><p id="detail-id" class="eyebrow">ID —</p><h2 id="detail-name">—</h2><p id="detail-email" class="muted">—</p></div>
                <div id="detail-status" class="status-badge">—</div>
            </div>
            <div class="dialog-tabs" role="tablist" aria-label="Раздел пользователя">
                <button class="tab is-active" type="button" data-user-tab="account">Аккаунт</button>
                <button class="tab" type="button" data-user-tab="statistics">Статистика</button>
                <button class="tab" type="button" data-user-tab="ranked-elo">Ranked Elo</button>
                <button class="tab" type="button" data-user-tab="scores">Скоры</button>
                <button class="tab" type="button" data-user-tab="logins">Входы</button>
            </div>

            <section id="user-tab-account" class="user-tab is-active">
                <form id="user-edit-form" class="stack">
                    <div class="form-grid">
                        <label class="field"><span>Имя пользователя</span><input id="detail-username" name="username" type="text" required minlength="2" maxlength="15" autocomplete="off"></label>
                        <label class="field"><span>Страна</span><select id="detail-country" name="country_code"></select></label>
                        <label class="field"><span>Состояние аккаунта</span><select id="detail-active" name="is_active"><option value="true">Активен</option><option value="false">Отключён</option></select></label>
                    </div>
                    <fieldset class="check-grid">
                        <legend>Права и отметки</legend>
                        <label><input id="detail-supporter" type="checkbox" name="is_supporter"><span>Supporter</span></label>
                        <label><input id="detail-gmt" type="checkbox" name="is_gmt"><span>Модератор</span></label>
                        <label><input id="detail-qat" type="checkbox" name="is_qat"><span>QAT</span></label>
                        <label><input id="detail-bng" type="checkbox" name="is_bng"><span>BNG / ранкер</span></label>
                        <label><input id="detail-admin" type="checkbox" name="is_admin"><span>Администратор</span></label>
                        <label><input id="detail-owner" type="checkbox" name="is_owner"><span>Владелец</span></label>
                    </fieldset>
                    <label class="field"><span>Причина изменения</span><textarea id="detail-reason" required minlength="2" maxlength="500" rows="2" placeholder="Будет записана в историю"></textarea></label>
                    <button id="user-save" class="button button-primary" type="submit">Сохранить изменения</button>
                </form>

                <section id="password-section" class="danger-zone" hidden>
                    <div><strong>Сменить пароль</strong><p>Все активные сессии пользователя будут завершены.</p></div>
                    <button id="password-open" class="button button-danger-quiet" type="button">Сменить</button>
                    <form id="password-form" class="stack" hidden>
                        <div class="form-grid">
                            <label class="field"><span>Новый пароль</span><input id="new-password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required></label>
                            <label class="field"><span>Повторите пароль</span><input id="confirm-password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required></label>
                        </div>
                        <label class="field"><span>Причина</span><input id="password-reason" type="text" minlength="2" maxlength="500" required></label>
                        <div class="button-row"><button class="button button-danger" type="submit">Подтвердить смену</button><button id="password-cancel" class="button button-secondary" type="button">Отмена</button></div>
                    </form>
                </section>

                <section id="profile-clear-section" class="danger-zone" hidden>
                    <div><strong>Полностью очистить игровой профиль</strong><p>Удалит все скоры, replay, PP, статистику, медали и историю ранга. Сам аккаунт, пароль и права останутся.</p></div>
                    <button id="profile-clear-open" class="button button-danger-quiet" type="button">Очистить</button>
                    <form id="profile-clear-form" class="stack" hidden>
                        <label class="field"><span>Причина</span><input id="profile-clear-reason" type="text" minlength="2" maxlength="500" required placeholder="Будет записана в аудит"></label>
                        <label class="field"><span>Введите ник пользователя для подтверждения</span><input id="profile-clear-confirmation" type="text" maxlength="32" autocomplete="off" required></label>
                        <label class="check-line"><input id="profile-clear-public" type="checkbox" checked><span>Также сбросить аватар и описание профиля</span></label>
                        <div class="button-row"><button class="button button-danger" type="submit">Удалить игровые данные</button><button id="profile-clear-cancel" class="button button-secondary" type="button">Отмена</button></div>
                    </form>
                </section>
            </section>
            <section id="user-tab-statistics" class="user-tab" hidden><div id="detail-statistics" class="stats-list"></div></section>
            <section id="user-tab-ranked-elo" class="user-tab" hidden>
                <div class="panel-header compact"><div><p class="eyebrow">Рейтинговый мультиплеер</p><h3>Ranked Elo</h3></div></div>
                <p id="ranked-elo-empty" class="muted" hidden>Ranked-пулы ещё не настроены.</p>
                <form id="ranked-elo-form" class="stack">
                    <label class="field"><span>Режим и пул</span><select id="ranked-elo-pool" required></select></label>
                    <p id="ranked-elo-current" class="muted" aria-live="polite"></p>
                    <label class="field"><span>Новое Elo</span><input id="ranked-elo-value" type="number" min="0" max="10000" step="1" required inputmode="numeric" placeholder="0–10 000"></label>
                    <label class="field"><span>Причина изменения</span><input id="ranked-elo-reason" type="text" minlength="2" maxlength="500" required placeholder="Будет записана в историю действий"></label>
                    <p id="ranked-elo-permission" class="muted" hidden>Рейтинг администратора или владельца может изменить только владелец.</p>
                    <p class="muted">Если игрок уже открыл Ranked, после изменения ему нужно выйти из очереди и войти заново.</p>
                    <div class="button-row">
                        <button id="ranked-elo-save" class="button button-primary" type="submit">Сохранить Elo</button>
                        <button id="ranked-elo-refresh" class="button button-secondary" type="button">Обновить данные</button>
                    </div>
                </form>
            </section>
            <section id="user-tab-scores" class="user-tab" hidden>
                <div class="panel-header compact"><div><p class="eyebrow">результаты</p><h3>Скоры пользователя</h3></div><span id="detail-score-count" class="count-pill">0</span></div>
                <div id="detail-scores" class="admin-score-list"></div>
            </section>
            <section id="user-tab-logins" class="user-tab" hidden><div id="detail-logins" class="login-list"></div></section>
        </div>
    </dialog>

    <dialog id="resolve-dialog" class="dialog dialog-small">
        <form method="dialog"><button class="dialog-close" value="cancel" aria-label="Закрыть">×</button></form>
        <p class="eyebrow">Уведомление</p>
        <h2>Отметить просмотренным?</h2>
        <p class="muted">Событие останется в истории, но исчезнет из списка новых.</p>
        <form id="resolve-form" class="stack">
            <input id="resolve-event-id" type="hidden">
            <label class="field"><span>Комментарий</span><textarea id="resolve-reason" minlength="2" maxlength="500" rows="3" required>Проверено в админ-панели</textarea></label>
            <div class="button-row"><button class="button button-primary" type="submit">Закрыть уведомление</button><button id="resolve-cancel" class="button button-secondary" type="button">Отмена</button></div>
        </form>
    </dialog>

    <div id="toast-region" class="toast-region" role="status" aria-live="polite" aria-atomic="true"></div>
    <script src="./app.js" defer></script>
</body>
</html>
