        <PackageReference Include="Lib.Harmony" Version="2.4.2" />
        <!-- Newest public package available for the installed 2026.804.2 client. -->
        <PackageReference Include="ppy.osu.Game" Version="2026.916.0" />
    </ItemGroup>
</Project>
