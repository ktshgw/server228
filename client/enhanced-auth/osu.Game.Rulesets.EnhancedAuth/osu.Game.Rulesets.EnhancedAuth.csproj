        <TargetFramework>net10.0</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <AssemblyTitle>osu.Game.Rulesets.EnhancedAuth</AssemblyTitle>
        <OutputType>Library</OutputType>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <RootNamespace>osu.Game.Rulesets.EnhancedAuth</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\**" Exclude="Resources\SomsAi\ocean-background.png;Resources\SomsAi\ocean-background-clear.png" />
    </ItemGroup>
    <ItemGroup>
