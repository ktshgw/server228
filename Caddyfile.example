# Замените домен на тот же HTTPS origin, который указан в .env и
# client/launcher/launcher.json. Здесь Caddy работает на host, а compose nginx
# привязан к 127.0.0.1:8000.
lazer.example.net {
	# /_lio нужен только spectator-контейнеру во внутренней Docker network.
	# Никогда не открывайте его игрокам или интернету.
	@internal_lio path /_lio /_lio/*
	respond @internal_lio 404

	encode zstd gzip
	reverse_proxy 127.0.0.1:8000 {
		# soms recognises these provider-specific headers. This example does
		# not run behind those providers, so never trust values sent by a client.
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
	}
}
